STRWINCOND000 = " ";
STRWINCOND001 = "Secure the second floor of the Russian Embassy Compound.";
STRWINCOND002 = "Rendezvous with team 2 on the first floor.";
STRWINCOND003 = "Go to the basement and breach the bunker door.";
STRWINCOND004 = "Find a way down one floor and secure it.";
STRWINCOND005 = "Go upstairs to the room where the Tier One officials were.";
STRWINCOND006 = "Pursue the Tier One Officials into the tunnels.";
STRWINCOND007 = "Exit the tunnels and reach the Black Hawk for extraction.";

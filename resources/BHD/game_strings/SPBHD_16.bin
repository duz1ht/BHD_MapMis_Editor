STRWINCOND001 = "Protect the convoy from enemy militia while en route to the crash site";
STRWINCOND002 = "Dismount from the Humvee and move out to the crash site on foot";
STRWINCOND003 = "Set up a sniping position overlooking the crash site, on the roof of the bombed out building";
STRWINCOND004 = "Defend soldiers at the crash site until they can be evacuated";
STRWINCOND005 = "Move to the crash site on foot";
STRWINCOND006 = "Take out all RPG militia on buildings surrounding the crash site";
STRWINCOND007 = "null";

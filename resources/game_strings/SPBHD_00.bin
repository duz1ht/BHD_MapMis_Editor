'[Mission Dialog]'
STRDLGLINE000 = "Link up with the troops at the front of the convoy.";

'[Triggered Text]'

'[Info]'
Title = "Weapons Range South";
briefing = "Weapons Range South
Use this firing range to test out all of the weapons available to the U.S. Forces in Somalia. Access to all standard weapons will be provided along with various moving and stationary targets. You can change weapons and reload ammunition in any one of the armories. 
";

'[WinConditions]'
STRWINCOND000 = "null";
STRWINCOND001 = "3 different armory types are available";
STRWINCOND002 = "Try your hand at engaging targets with squad machine guns";
STRWINCOND003 = "Engage targets at up to 800m on this range with the sniper rifles";
STRWINCOND004 = "Use the AT4 or M203 grenade launcher to destroy moving vehicles";
STRWINCOND005 = "Use hand grenades to destroy targets behind bunkers";
STRWINCOND006 = "Use satchel charges to destroy target emplaced weapons and enemy munitions";
STRWINCOND007 = "Avoid entering the minefield";
STRWINCOND008 = "Press ESC to exit back to the menus";

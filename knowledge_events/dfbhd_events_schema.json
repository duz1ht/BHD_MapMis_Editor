  "reference_update_rules": {
    "insert_event_at_index_i": [
      "Increment EVENT trigger var1 when >= i",
      "Increment RESET_EVENT action var1 when >= i",
      "Increment waypoint wp_adv_trigger when >= i"
    ],
    "swap_events_i_j": [
      "Swap complete event blocks",
      "Swap references equal to i/j in EVENT triggers",
      "Swap references equal to i/j in RESET_EVENT actions",
      "Swap references equal to i/j in wp_adv_trigger"
    ],
    "delete_event_i": [
      "Delete EVENT trigger rows whose var1 == i",
      "Decrement EVENT trigger var1 when > i",
      "For RESET_EVENT action var1 >= i, decrement it; an exact reference is not deleted",
      "For wp_adv_trigger > i decrement; for == i set -1 after warning"
    ]
  }
